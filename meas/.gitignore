__pycache__/
*.pyc
*.egg-info/
build/
dist/

# The app writes recordings wherever it is launched from, and each one drops a
# JSON sidecar beside it. That is session output, not repo content.
*.csv
*.meta.json
*.parquet
*.feather

# ...except the runs the presentation actually uses, named one by one. A
# blanket !data/*.csv is the wrong default here: raw recordings run to tens of
# MB (the chamber sweep alone is 82 MB) and one stray `git add -A` commits them.
!data/2026-07-31_dual_15min.csv
!data/jnwtemp-BOTH-20260731-213248.csv
!data/jnwtemp-BOTH-20260731-223642.csv

# The chamber sweep, reduced to the settled dwells. This is the committed
# source of truth: scripts/chamber_figures.py falls back to it when the raw
# run is absent, and reproduces every number from it.
!data/2026-08-03_chamber_dwell.csv
!data/2026-08-03_chamber_summary.csv
!data/2026-08-03_chamber_trace.csv
!data/2026-08-03_chamber_dnl.csv
!data/2026-08-03_chamber.meta.json

# Reduced results for the per-design decks: a few kB, and the deck cannot be
# rebuilt without them since the raw captures stay local.
!data/ring_data.json

# Regenerated from data/ by the analysis scripts.
data/deck_data.json
data/event_data.json
