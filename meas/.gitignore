__pycache__/
*.pyc
*.egg-info/
build/
dist/

# The app writes recordings wherever it is launched from, and each one drops a
# JSON sidecar beside it. That is session output, not repo content.
*.csv
*.meta.json
*.parquet
*.feather

# ...except measurement runs deliberately kept with the repo.
!data/*.csv

# Regenerated from data/ by the analysis scripts.
data/deck_data.json
data/event_data.json

# Only the runs the presentation actually uses are kept in the repo; other
# captures are 1 ms recordings of ~5 MB/minute and stay local.
data/jnwtemp-GR07-*.csv
